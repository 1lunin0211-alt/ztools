  <FilterRulesList>
    <CustomRule>
      <name>Изготавливаемые детали с покрытием</name>
      <type>false</type>
      <RuleList>
        <string>$Тип$	|@#$%|содержит	|@#$%|Мехобработка;Листовой металл;Отливка;Сварные детали</string>
        <string>$Покрытие$	|@#$%|не равно	|@#$%|</string>
      </RuleList>
    </CustomRule>
    <CustomRule>
      <name>Изготавливаемые детали без покрытия</name>
      <type>false</type>
      <RuleList>
        <string>$Тип$	|@#$%|содержит	|@#$%|Мехобработка;Листовой металл;Отливка;Сварные детали</string>
        <string>$Покрытие$	|@#$%|равно	|@#$%|</string>
      </RuleList>
    </CustomRule>
    <CustomRule>
      <name>Изготавливаемые детали с чертежом</name>
      <type>false</type>
      <RuleList>
        <string>$Тип$	|@#$%|содержит	|@#$%|Мехобработка;Листовой металл;Отливка;Сварные детали</string>
        <string>&lt;Наличие чертежа&gt;	|@#$%|равно	|@#$%|Есть</string>
      </RuleList>
    </CustomRule>
    <CustomRule>
      <name>Изготавливаемые детали без чертежа</name>
      <type>false</type>
      <RuleList>
        <string>$Тип$	|@#$%|содержит	|@#$%|Мехобработка;Листовой металл;Отливка;Сварные детали</string>
        <string>&lt;Наличие чертежа&gt;	|@#$%|равно	|@#$%|Нет</string>
      </RuleList>
    </CustomRule>
    <CustomRule>
      <name>Изготавливаемые детали</name>
      <type>false</type>
      <RuleList>
        <string>$Тип$	|@#$%|содержит	|@#$%|Мехобработка;Листовой металл;Отливка;Сварные детали</string>
      </RuleList>
    </CustomRule>
    <CustomRule>
      <name>Элементы без обязательных свойств</name>
      <type>true</type>
      <RuleList>
        <string>%Тип%	|@#$%|равно	|@#$%|</string>
        <string>%Обозначение%	|@#$%|равно	|@#$%|</string>
        <string>%Материал%	|@#$%|равно	|@#$%|</string>
        <string>%Масса%	|@#$%|равно	|@#$%|</string>
        <string>%Наименование детали%	|@#$%|равно	|@#$%|</string>
      </RuleList>
    </CustomRule>
    <CustomRule>
      <name>Покупные изделия</name>
      <type>false</type>
      <RuleList>
        <string>$Тип$	|@#$%|содержит	|@#$%|Покупное;Покупное;</string>
      </RuleList>
    </CustomRule>
  </FilterRulesList>
